      "source": [
        "import os\n",
        "\n",
        "# Define the specific credit files to load\n",
        "credit_files_to_load_names = [\n",
        "    'Credit Data - 01-01-2025.csv',\n",
        "    'Credit Data - 30-03-2025.csv',\n",
        "    'Credit Data - 30-06-2025.csv',\n",
        "    'Credit Data - 30-09-2025.csv',\n",
        "    'Credit Data - 30-12-2025.csv'\n",
        "]\n",
        "\n",
        "# Construct full paths for the files\n",
        "files_to_load_full_paths = [f'/content/{fname}' for fname in credit_files_to_load_names]\n",
        "\n",
        "df_list = []\n",
        "\n",
        "print(\"Attempting to load the following files:\")\n",
        "for file_path in files_to_load_full_paths:\n",
        "    print(file_path)\n",
        "    try:\n",
        "        current_df = pd.read_csv(file_path)\n",
        "        df_list.append(current_df)\n",
        "        print(f\"Successfully loaded {file_path}\")\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: File not found at {file_path}. Skipping this file.\")\n",
        "    except Exception as e:\n",
        "        print(f\"An error occurred while loading {file_path}: {e}. Skipping this file.\")\n",
        "\n",
        "# Concatenate all DataFrames in the list\n",
        "if df_list:\n",
        "    df_combined = pd.concat(df_list, ignore_index=True, sort=False)\n",
        "    print(\"\\nCombined Credit Data DataFrame created successfully. Displaying the first 5 rows:\")\n",
        "    display(df_combined.head())\n",
        "    print(f\"Total rows in combined DataFrame: {len(df_combined)}\")\n",
        "else:\n",
        "    print(\"No Credit Data DataFrames were loaded. 'df_combined' is not created.\")"
      ]
    },
