      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 4. Visualize Trends\n",
        "fig, axes = plt.subplots(nrows=3, ncols=1, figsize=(12, 18), sharex=True)\n",
        "fig.suptitle('Portfolio Arrears, Collection Efficiency, and FPD Trends (Jan-Dec 2025)', fontsize=16)\n",
        "\n",
        "# Arrears Rate Trend\n",
