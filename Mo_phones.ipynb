      "source": [
        "# 1. Identify First Payment Default (FPD) loans\n",
        "# A loan is considered an FPD if it has DAYS_PAST_DUE > 0 at its very first recorded snapshot date.\n",
        "first_loan_snapshot = df.sort_values(by=['LOAN_ID', 'DATE']).groupby('LOAN_ID').first().reset_index()\n",
        "fpd_loan_ids = first_loan_snapshot[first_loan_snapshot['DAYS_PAST_DUE'] > 0]['LOAN_ID'].unique()\n",
        "\n",
        "# Create an 'is_fpd' column in the main DataFrame\n",
        "df['is_fpd'] = df['LOAN_ID'].isin(fpd_loan_ids)\n",
        "\n",
        "# 2. Aggregate portfolio metrics by DATE\n",
        "portfolio_performance_trends = df.groupby('DATE').agg(\n",
        "    Total_Loans=('LOAN_ID', 'nunique'),\n",
        "    Sum_of_Arrears_KES=('ARREARS', 'sum'),\n",
        "    Sum_of_Total_Paid=('TOTAL_PAID', 'sum'),\n",
        "    Sum_of_Total_Due_Today=('TOTAL_DUE_TODAY', 'sum'),\n",
        "    FPD_Loans_Count=('is_fpd', lambda x: x.sum()) # Count True values (FPD loans)\n",
        ").reset_index()\n",
        "\n",
        "# Convert FPD_Loans_Count to integer\n",
        "portfolio_performance_trends['FPD_Loans_Count'] = portfolio_performance_trends['FPD_Loans_Count'].astype(int)\n",
        "\n",
        "# 3. Calculate Rates\n",
        "portfolio_performance_trends['Arrears_Rate_PCT'] = (portfolio_performance_trends['Sum_of_Arrears_KES'] / portfolio_performance_trends['Sum_of_Total_Due_Today']) * 100\n",
        "portfolio_performance_trends['Collection_Efficiency_PCT'] = (portfolio_performance_trends['Sum_of_Total_Paid'] / portfolio_performance_trends['Sum_of_Total_Due_Today']) * 100\n",
        "# FPD Rate: Percentage of FPD loans among all active loans at that snapshot date\n",
        "portfolio_performance_trends['FPD_Rate_PCT'] = (portfolio_performance_trends['FPD_Loans_Count'] / portfolio_performance_trends['Total_Loans']) * 100\n",
        "\n",
        "# Display the aggregated portfolio performance trends\n",
        "print(\"\\nPortfolio Performance Metrics (Jan-Dec 2025):\")\n",
        "display(portfolio_performance_trends.round(2))"
      ]
    },
