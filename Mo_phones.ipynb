      "source": [
        "age_band_analysis = df_merged.groupby('Age_Band').agg(\n",
        "    Total_Loans=('LOAN_ID', 'nunique'),\n",
        "    Total_Arrears_KES=('ARREARS', 'sum'),\n",
        "    Total_Paid_KES=('TOTAL_PAID', 'sum'),\n",
        "    Total_Due_Today_KES=('TOTAL_DUE_TODAY', 'sum')\n",
        ").reset_index()\n",
        "\n",
        "age_band_analysis['Average_Arrears_Rate_PCT'] = (age_band_analysis['Total_Arrears_KES'] / age_band_analysis['Total_Due_Today_KES']) * 100\n",
        "\n",
        "# Identify the age band with the highest average arrears rate\n",
        "riskiest_age_band = age_band_analysis.loc[age_band_analysis['Average_Arrears_Rate_PCT'].idxmax()]\n",
        "\n",
        "print(\"Portfolio Performance by Age Band:\")\n",
        "display(age_band_analysis.round(2))\n",
        "\n",
        "print(f\"\\nThe riskiest age band is: {riskiest_age_band['Age_Band']} with an average arrears rate of {riskiest_age_band['Average_Arrears_Rate_PCT']:.2f}%.\")"
      ]
