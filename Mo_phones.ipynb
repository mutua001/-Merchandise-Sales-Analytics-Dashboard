        "import numpy as np\n",
        "\n",
        "# Define age bins and labels as requested\n",
        "age_bins = [0, 25, 35, 45, 55, np.inf] # Assuming 18 is the minimum age, starting from 0 to capture all ages\n",
        "age_labels = ['18-25', '26-35', '36-45', '46-55', '55+']\n",
        "\n",
        "# Create the 'Age_Band' column in df_merged\n",
        "df_merged['Age_Band'] = pd.cut(\n",
        "    df_merged['CUSTOMER_AGE'],\n",
        "    bins=age_bins,\n",
        "    labels=age_labels,\n",
        "    right=True,\n",
        "    include_lowest=True\n",
        ")\n",
        "\n",
        "print(\"Age bands created successfully. Displaying the count of loans per age band:\")\n",
