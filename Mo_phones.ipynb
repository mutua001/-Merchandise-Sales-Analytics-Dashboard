      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Rename the long NPS score column for easier use\n",
        "df_final.rename(columns={'Using a scale from 0 (not likely) to 10 (very likely), how likely are you to recommend MoPhones to friends or family?': 'NPS_Score'}, inplace=True)\n",
        "\n",
        "# Define NPS categories\n",
        "def categorize_nps(score):\n",
        "    if score >= 9:\n",
        "        return 'Promoter'\n",
        "    elif score >= 7:\n",
        "        return 'Passive'\n",
        "    elif score >= 0:\n",
        "        return 'Detractor'\n",
        "    else:\n",
        "        return None\n",
        "\n",
        "df_final['NPS_Category'] = df_final['NPS_Score'].apply(categorize_nps)\n",
        "\n",
        "print(\"NPS categories created successfully. Displaying counts:\")\n",
        "display(df_final['NPS_Category'].value_counts(dropna=False))\n",
        "\n",
        "# Analyze NPS Category by Account Status (L1)\n",
        "print(\"\\nNPS Category distribution by Account Status (L1):\")\n",
        "nps_by_account_status = df_final.groupby('ACCOUNT_STATUS_L1')['NPS_Category'].value_counts(normalize=True).unstack().fillna(0) * 100\n",
        "display(nps_by_account_status.round(2))\n",
        "\n",
        "# Analyze Average NPS Score by Days Past Due (Binned)\n",
        "# Let's create bins for DAYS_PAST_DUE to simplify the analysis\n",
        "days_past_due_bins = [-1, 0, 7, 30, 90, df_final['DAYS_PAST_DUE'].max()]\n",
        "days_past_due_labels = ['No_Arrears', '1-7_Days_Due', '8-30_Days_Due', '31-90_Days_Due', '90+_Days_Due']\n",
        "\n",
        "df_final['Days_Past_Due_Band'] = pd.cut(\n",
        "    df_final['DAYS_PAST_DUE'],\n",
        "    bins=days_past_due_bins,\n",
        "    labels=days_past_due_labels,\n",
        "    right=True,\n",
        "    include_lowest=True\n",
        ")\n",
        "\n",
        "print(\"\\nAverage NPS Score by Days Past Due Band:\")\n",
        "avg_nps_by_dpd = df_final.groupby('Days_Past_Due_Band')['NPS_Score'].mean().reset_index()\n",
        "display(avg_nps_by_dpd.round(2))\n",
        "\n",
        "# Visualize the relationship (optional, but good for understanding)\n",
        "fig = plt.figure(figsize=(12, 6)) # Assign the figure to a variable\n",
        "sns.barplot(x='Days_Past_Due_Band', y='NPS_Score', data=avg_nps_by_dpd)\n",
        "plt.title('Average NPS Score by Days Past Due Band')\n",
        "plt.ylabel('Average NPS Score')\n",
        "plt.xlabel('Days Past Due Band')\n",
        "plt.show()\n",
        "plt.close(fig) # Explicitly close the figure"
      ]
    },
